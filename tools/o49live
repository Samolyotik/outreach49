#!/bin/sh
# Тот же CLI, но по БОЕВОЙ базе. Для чтения: что в диалогах, что уехало людям,
# что лежит у менеджера. Код при этом берётся из песочницы — можно смотреть
# живые данные глазами своей версии движка.
#
# Пишущие команды здесь отклоняются. Не из осторожности вообще, а из-за одного
# конкретного пути: `autoreply run` кладёт задачи в ту же базу, откуда боевой
# `dispatch` их выпускает, — и человек получил бы два ответа на одно сообщение.
set -e
case "$1" in
autoreply | dispatch | poll | send | reply | invites | forum | arm | demo | ramp)
    echo "o49live: '$1' пишет в базу — на боевой её не запускают." >&2
    echo "В песочнице:  o49lab $*" >&2
    exit 2
    ;;
esac
export BRIDGE49_DB=/opt/outreach49/var/bridge49.sqlite
exec /usr/local/bin/o49lab "$@"
