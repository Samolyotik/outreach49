#!/bin/sh
# Прямой SQL. По умолчанию — БОЕВАЯ база, с `--lab` — копия песочницы.
#
#   o49sql                                   # оболочка по боевой
#   o49sql .tables
#   o49sql "select * from inbound limit 5"
#   o49sql --lab "select * from tasks limit 5"   # по своей копии
#
# Полезные таблицы: inbound (входящие от Radar), history (переписка),
# threads (диалоги), tasks (что отправлено), handoffs (карточки менеджеру),
# events (журнал), direct_invites, demo_invites.
#
# Решения движка лежат в events; actor там 'cli' или 'autoreply' в зависимости
# от того, чем запущен разбор, поэтому отбирать надо по kind:
#   select at, kind, detail from events
#    where kind like 'autoreply.%' and kind <> 'autoreply.run'
#    order by id desc limit 20;
DB=/opt/outreach49/var/bridge49.sqlite
if [ "$1" = "--lab" ]; then
    DB=/opt/outreach49-lab/var/bridge49.sqlite
    shift
fi
exec sqlite3 -box "$DB" "$@"
