[Unit]
Description=outreach49 резервная копия базы каждые 6 часов

[Timer]
# Шесть часов — компромисс между ценой (копия базы на 20 МБ снимается за
# доли секунды) и тем, сколько работы контура не жалко потерять. Семь копий
# при таком шаге держат почти двое суток истории.
OnBootSec=10min
OnUnitActiveSec=6h
AccuracySec=1min
# Разброс, чтобы копия не приходилась ровно на тот же момент, что и остальные
# таймеры после перезагрузки машины.
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
