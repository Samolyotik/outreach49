[Unit]
Description=outreach49 разведка — одна проверка в минуту

[Timer]
# Шаг подобран под паузу флота, а не наоборот. Пауза между чтениями разных
# аккаунтов — 60–90 секунд (профиль прежнего контура), и дольше минуты внутри
# одного прогона диспетчер не ждёт: задача просто откладывается до следующего
# раза. Минутный шаг с батчем в одну команду и даёт ровно тот темп, который
# пауза разрешает, — около сорока восьми проверок в час.
#
# Большой батч здесь был бы обманом: сорок задач всё равно упёрлись бы в ту же
# паузу, отложились и вернулись на следующий прогон.
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=5s

[Install]
WantedBy=timers.target
