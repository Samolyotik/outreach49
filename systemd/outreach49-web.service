[Unit]
Description=outreach49 — веб-панель только для чтения (localhost)
After=network-online.target

[Service]
WorkingDirectory=/opt/outreach49
Environment=BRIDGE49_HOME=/opt/outreach49
ExecStart=/opt/outreach49/bin/bridge49 serve --host 127.0.0.1 --port 8649
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
