[Unit]
Description=outreach49 — выпустить созревшие чтения метаданных
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/outreach49
Environment=BRIDGE49_HOME=/opt/outreach49
# `--read` сужает выпуск до класса чтения. Без него таймер выпускал бы заодно
# всё, что созрело в рассылочных кампаниях, — а рассылка здесь по решению
# владельца остаётся на ручном управлении. Сужение по классу, а не по имени
# кампании: кампаний разведки две (каналы и чаты), а класс у них один.
#
# Батч больше единицы не ради скорости — её всё равно держит пауза флота
# (60–90 с), и лишние задачи просто откладываются до следующего прогона. Он
# нужен, чтобы прогон умел смотреть дальше первой задачи: пока часть аккаунтов
# на паузе (поэтапный запуск), голова очереди почти всегда принадлежит кому-то
# приостановленному, и с батчем в единицу разведка стояла бы намертво.
TimeoutStartSec=300
ExecStart=/opt/outreach49/bin/bridge49 dispatch --read --confirm --limit 25

[Install]
WantedBy=multi-user.target
