[Unit]
Description=outreach49 выпуск ссылок каждую минуту

[Timer]
# Человек только что согласился и ждёт ссылку — это не фоновая задача. Минута
# здесь потолок ожидания, а не темп: пустой проход не делает ни одного сетевого
# вызова, потому что выпускать нечего.
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=5s
# Разводим с остальными таймерами, чтобы реже спорить за общий замок выпуска.
RandomizedDelaySec=10

[Install]
WantedBy=timers.target
