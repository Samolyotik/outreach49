[Unit]
Description=outreach49 — новый читатель каждые полчаса

[Timer]
# Полчаса — ступень, на которой видно результат предыдущей. Аккаунт делает
# проверку раз в 9–20 минут, значит к следующей ступени у нового читателя уже
# есть один-два ответа: если разбор врёт или цели мертвы, это видно до того,
# как подключится весь флот.
#
# Тринадцать читателей вводятся за шесть с половиной часов.
OnBootSec=30min
OnUnitActiveSec=30min
AccuracySec=1min
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
