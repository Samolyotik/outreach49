[Unit]
Description=outreach49 — разобрать входящие движком и поставить ответы
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/outreach49
Environment=BRIDGE49_HOME=/opt/outreach49
# Граница с моделью. Реквизиты Codex и прокси лежат в окружении прежнего
# контура: сессия Codex общая по решению владельца от 03.08.2026, отдельного
# логина у outreach49 нет.
EnvironmentFile=/etc/tgradar-outreach/production.env
# Автовыдача бесплатного теста. Движку нужен точный список сфер, которым доступ
# выдаётся без менеджера: без него он всегда выбирает ручной путь — не потому
# что так решил, а потому что не видит альтернативы. Файл берём у прежнего
# контура как есть, а не копируем: два списка разрешённых сфер неминуемо
# разъехались бы, и доступ пошёл бы выдаваться по устаревшему.
EnvironmentFile=-/etc/tgradar-outreach/startbot.env
# Словарь сфер. Свой файл, потому что общий с прежним контуром править опасно —
# почему именно так, написано в самом файле. Ключи с `llm.env` не пересекаются,
# так что взаимный порядок этих двух безразличен; `llm.env` оставлен последним.
EnvironmentFile=/opt/outreach49/deployment/sector.env
# Наша обёртка модели — и только файлом, не строкой `Environment=`.
#
# `production.env` выше задаёт `OUTREACH_LLM_COMMAND` на обёртку прежнего
# контура, а `EnvironmentFile=` перебивает `Environment=` независимо от того,
# что стоит в юните ниже. Проверено на этой машине опытом. Прежняя строка
# `Environment=` здесь и стояла — и была мертва с самого переезда: разбор
# входящих 06.08 весь день ходил в чужую обёртку.
#
# Цена ошибки не в том, что обёртка чужая, а в том, что она собирает модели
# другую схему ответа: у неё в `required` четырнадцать полей, у нас
# семнадцать. Схема отдаётся модели как `--output-schema`, то есть жёстко;
# вернуть три недостающих поля модель физически не могла. Наша же проверка
# требует все семнадцать и валит ход в `technical_failure`, а он молчит по
# замыслу. Итог — ни одного автоответа за день и карточка на каждого живого
# человека.
#
# Файл идёт последним намеренно: среди `EnvironmentFile=` побеждает последний.
EnvironmentFile=/opt/outreach49/deployment/llm.env
# Один вызов модели идёт 20–60 секунд, разбор идёт по одному входящему за раз.
# Двадцать сообщений в худшем случае — двадцать минут, поэтому запас большой.
TimeoutStartSec=1800
ExecStart=/opt/outreach49/bin/bridge49 autoreply run --limit 20

[Install]
WantedBy=multi-user.target
