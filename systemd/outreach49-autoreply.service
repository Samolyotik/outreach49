[Unit]
Description=outreach49 — разобрать входящие движком и поставить ответы
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/outreach49
Environment=BRIDGE49_HOME=/opt/outreach49
# Граница с моделью. Реквизиты Codex и прокси лежат в окружении прежнего
# контура: сессия Codex общая по решению владельца от 03.08.2026, отдельного
# логина у outreach49 нет.
EnvironmentFile=/etc/tgradar-outreach/production.env
# Автовыдача бесплатного теста. Движку нужен точный список сфер, которым доступ
# выдаётся без менеджера: без него он всегда выбирает ручной путь — не потому
# что так решил, а потому что не видит альтернативы. Файл берём у прежнего
# контура как есть, а не копируем: два списка разрешённых сфер неминуемо
# разъехались бы, и доступ пошёл бы выдаваться по устаревшему.
EnvironmentFile=-/etc/tgradar-outreach/startbot.env
# Кавычки обязательны: без них systemd режет значение по пробелу, переменной
# достаётся только путь к python, а сам скрипт молча отбрасывается —
# «Invalid environment assignment». Модель тогда не вызывается вовсе.
Environment="OUTREACH_LLM_COMMAND=/opt/outreach49/venv/bin/python /opt/outreach49/scripts/codex_llm_wrapper.py"
# Один вызов модели идёт 20–60 секунд, разбор идёт по одному входящему за раз.
# Двадцать сообщений в худшем случае — двадцать минут, поэтому запас большой.
TimeoutStartSec=1800
ExecStart=/opt/outreach49/bin/bridge49 autoreply run --limit 20

[Install]
WantedBy=multi-user.target
