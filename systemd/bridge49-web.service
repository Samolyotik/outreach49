[Unit]
Description=bridge49 — веб-панель только для чтения (localhost)
After=network-online.target

[Service]
WorkingDirectory=/opt/bridge49
Environment=BRIDGE49_HOME=/opt/bridge49
ExecStart=/opt/bridge49/bin/bridge49 serve --host 127.0.0.1 --port 8649
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
